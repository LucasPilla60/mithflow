# Historial de dictados: contiene EN TEXTO PLANO todo lo que se dictó.
# Nunca debe commitearse ni salir de la máquina.
history.jsonl
history-nativo.jsonl
status.json
*.log

# Entornos y caché
.venv/
__pycache__/
*.pyc

# Modelos descargados (pesan 0.5-1.5 GB)
models/
app-nativa/models/

# Build de Rust / Tauri
target/
app-nativa/target/
node_modules/
dist/
# Generado por tauri-build para autocompletar las capabilities.
app-nativa/app/src-tauri/gen/
# Las 13 DLLs de ggml (~84 MB) que el build script junta para que el bundler
# las empaquete. Son artefactos de compilación: se regeneran solas.
app-nativa/app/src-tauri/transcribe-libs/

# NOTA: app-nativa/DECISIONES.md SÍ se versiona a propósito. Es el registro de
# las decisiones del spike (qué crate, qué backend, qué DLLs empaquetar) y es
# el insumo de los planes siguientes. No contiene datos sensibles.

# El instalador generado (12 MB). Se regenera con Generar-Instalador.ps1
instalador/

# Backups de base de datos (política global: nunca al repo)
backups/

# ----------------------------------------------------------------- claves
# La clave privada minisign que firma las actualizaciones vive FUERA del
# proyecto (%USERPROFILE%\.mithflow\), justamente para que nunca pueda entrar
# acá. Esto es la segunda red: si algún día alguien la copia al árbol "un
# minuto para probar algo", que no la pueda commitear por accidente.
#
# Quien tenga esa clave puede firmar un instalador que las tres máquinas van a
# bajar y ejecutar solas. No hay forma de revocarla.
*.key
*.pem
*.p12
*.pfx
*.asc
*.gpg
minisign*
*updater*.key*
.mithflow/
